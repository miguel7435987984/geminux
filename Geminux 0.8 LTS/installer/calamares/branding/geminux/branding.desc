# Geminux Branding for Calamares Installer
---
componentName: geminux
welcomeStyleCalamares: true
welcomeExpandingLogo: true
windowExpanding: normal
windowSize: 850px,580px
windowPlacement: center

strings:
    productName:         Geminux OS
    shortProductName:    Geminux
    version:             0.8 LTS
    shortVersion:        0.8
    versionedName:       Geminux 0.8 LTS
    shortVersionedName:  Geminux 0.8
    bootloaderEntryName: Geminux
    productUrl:          https://github.com/miguel7435987984/geminux
    supportUrl:          https://github.com/miguel7435987984/geminux/issues
    knownIssuesUrl:      https://github.com/miguel7435987984/geminux/issues
    releaseNotesUrl:     https://github.com/miguel7435987984/geminux/releases/tag/v0.8

images:
    productLogo:         "logo.png"
    productIcon:         "logo.png"
    productWelcome:      "welcome.png"

slideshow:               "show.qml"
slideshowAPI:            2

style:
   SidebarBackground:    "#0f141c"
   SidebarText:          "#e6edf3"
   SidebarTextSelect:    "#00d2ff"
   SidebarTextHighlight: "#38bdf8"
