class GeminuxRomCreator(Gtk.Window):
    def __init__(self):
        super().__init__(title=APP_NAME)
        self.set_default_size(960, 680)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_icon_name("geminux-rom-creator")

        # Detecção segura do diretório do repositório ou ambiente do sistema
        script_dir = os.path.dirname(os.path.abspath(__file__))
        potential_root = os.path.abspath(os.path.join(script_dir, "../.."))
        if os.path.isdir(os.path.join(potential_root, ".git")) or os.path.isdir(os.path.join(potential_root, "branding")):
            self.project_root = potential_root
        else:
            self.project_root = None

        self.is_building = False
        self.package_switches = {}

        self.apply_styles()
        self.setup_headerbar()
        self.build_ui()

    def get_default_output_dir(self):
        # 1. Se estiver no repositório de desenvolvimento do Geminux e for gravável
        if self.project_root and self.project_root != "/" and os.access(self.project_root, os.W_OK):
            candidate = os.path.join(self.project_root, "output")
            return candidate
        # 2. Pasta de Documentos do Usuário
        try:
            docs = GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_DOCUMENTS)
            if docs and os.path.isdir(docs) and os.access(docs, os.W_OK):
                return os.path.join(docs, "Geminux-Custom-ROMs")
        except Exception:
            pass
        # 3. Pasta Pessoal do Usuário (Home)
        return os.path.join(os.path.expanduser("~"), "Geminux-Custom-ROMs")

    def prepare_output_directory(self, out_dir):
        out_dir = (out_dir or "").strip()
        if not out_dir or out_dir == "/output" or out_dir == "/":
            out_dir = self.get_default_output_dir()
            self.entry_out_dir.set_text(out_dir)

        try:
            os.makedirs(out_dir, exist_ok=True)
            test_file = os.path.join(out_dir, ".geminux_perm_test")
            with open(test_file, "w", encoding="utf-8") as f:
                f.write("ok")
            if os.path.exists(test_file):
                os.remove(test_file)
            return True, out_dir
        except PermissionError:
            # Fallback automático para a pasta pessoal do usuário se tentar gravar na raiz ou sem permissão
            fallback = self.get_default_output_dir()
            if fallback == "/output" or fallback.startswith("/root"):
                fallback = os.path.join(os.path.expanduser("~"), "Geminux-Custom-ROMs")
            try:
                os.makedirs(fallback, exist_ok=True)
                self.entry_out_dir.set_text(fallback)
                self.append_log(f"⚠️ Permissão negada para '{out_dir}'. Redirecionado com segurança para: '{fallback}'")
                return True, fallback
            except Exception as e:
                return False, f"Permissão negada para gravar em '{out_dir}'. Escolha uma pasta com permissão de escrita (ex: Documentos ou Pasta Pessoal)."
        except Exception as e:
            return False, f"Não foi possível acessar a pasta '{out_dir}': {e}"

