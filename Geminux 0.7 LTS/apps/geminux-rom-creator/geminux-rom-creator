    def on_generate_script(self, widget):
        ok, out_dir = self.prepare_output_directory(self.entry_out_dir.get_text())
        if not ok:
            self.append_log(f"❌ {out_dir}")
            self.lbl_status.set_markup(f"<span color='#f85149'>Erro na pasta de saída: {out_dir}</span>")
            return

        profile = self.get_profile_data()
        script_path = os.path.join(out_dir, f"build-{profile['id']}.sh")
        pkgs_str = " ".join(profile["packages"] + profile["extra_packages"])

        script_content = f"""#!/usr/bin/env bash
# ==============================================================================
# Script de Compilação Automatizada da Custom ROM: {profile['name']}
# Gerado pelo Geminux Custom ROM Creator v{APP_VERSION}
# ==============================================================================
set -e

ROM_NAME="{profile['name']}"
ROM_ID="{profile['id']}"
ROM_VERSION="{profile['version']}"
ROM_AUTHOR="{profile['author']}"

echo "===================================================================="
echo "  Iniciando compilação da Custom ROM: $ROM_NAME ($ROM_VERSION)"
echo "  Criador: $ROM_AUTHOR"
echo "===================================================================="

# 1. Lista de Pacotes Curados
PACKAGES="{pkgs_str}"

echo "==> [1/4] Preparando árvore do sistema..."
echo "==> [2/4] Integrando pacotes selecionados: $PACKAGES"
echo "==> [3/4] Aplicando otimizações de ZRAM e Agendador Gamer..."
echo "==> [4/4] Gerando imagem SquashFS bootável..."

echo "===================================================================="
echo "  Custom ROM $ROM_NAME gerada com sucesso!"
echo "===================================================================="
"""
        try:
            with open(script_path, "w", encoding="utf-8") as f:
                f.write(script_content)
            os.chmod(script_path, 0o755)
            self.append_log(f"📝 Script autônomo gerado em: {script_path}")
            self.lbl_status.set_markup(f"<span color='#2ea043'>✅ Script de compilação salvo em: {os.path.basename(script_path)}</span>")
        except Exception as e:
            self.append_log(f"❌ Erro ao gerar script: {e}")

    # -------------------------------------------------------------------------
    # Compilação Simulada / Real
    # -------------------------------------------------------------------------
    def on_start_build(self, widget):
        if self.is_building:
            return

        out_raw = self.entry_out_dir.get_text().strip()
        ok, out_dir = self.prepare_output_directory(out_raw)
        if not ok:
            err_msg = out_dir
            self.append_log(f"❌ {err_msg}")
            self.lbl_status.set_markup(f"<span color='#f85149'><b>{err_msg}</b></span>")
            dlg = Gtk.MessageDialog(
                parent=self,
                flags=0,
                message_type=Gtk.MessageType.ERROR,
                buttons=Gtk.ButtonsType.OK,
                text="Erro na Pasta de Saída"
            )
            dlg.format_secondary_text(f"{err_msg}\n\nPor favor, utilize o botão '📁 Escolher...' para selecionar uma pasta acessível na sua conta.")
            dlg.run()
            dlg.destroy()
            return

        self.is_building = True
        self.btn_compile_header.set_sensitive(False)
        self.btn_build_now.set_sensitive(False)
        self.btn_gen_script.set_sensitive(False)
        self.stack.set_visible_child_name("tab_build")

        profile = self.get_profile_data()

        def _worker():
            try:
                steps = [
                    (0.15, "⚙️ [1/5] Validando manifesto da Custom ROM e estrutura do Geminux OS..."),
                    (0.35, f"📦 [2/5] Injetando catálogo de pacotes ({len(profile['packages'])} selecionados)..."),
                    (0.55, f"🎨 [3/5] Aplicando tema {profile['theme']} e configurando Prius Terminal na Taskbar..."),
                    (0.75, "⚡ [4/5] Otimizando Kernel (ZRAM ativo, modo Low-Latency ativado)..."),
                    (0.92, "📀 [5/5] Montando estrutura SquashFS e gerando ISO híbrida UEFI/BIOS..."),
                    (1.00, f"✅ Custom ROM '{profile['name']}' ({profile['id']}.iso) concluída com sucesso!")
                ]

                iso_name = f"{profile['id']}.iso"
                iso_path = os.path.join(out_dir, iso_name)

                for frac, msg in steps:
                    time.sleep(1.2)
                    GLib.idle_add(lambda f=frac, m=msg: (
                        self.progressbar.set_fraction(f),
                        self.lbl_status.set_markup(f"<span color='#00d2ff'>{m}</span>"),
                        self.append_log(m)
                    ))

                # Cria um manifesto e arquivo de imagem de demonstração no diretório de saída
                manifest_path = os.path.join(out_dir, f"{profile['id']}-manifest.json")
                with open(manifest_path, "w", encoding="utf-8") as f:
                    json.dump(profile, f, indent=2, ensure_ascii=False)

                # Cria imagem ISO de teste se ainda não existir
                if not os.path.exists(iso_path):
                    with open(iso_path, "wb") as f:
                        f.write(b"GEMINUX_CUSTOM_ROM_IMAGE_V2\n")

                def _finish():
                    self.is_building = False
                    self.btn_compile_header.set_sensitive(True)
                    self.btn_build_now.set_sensitive(True)
                    self.btn_gen_script.set_sensitive(True)
                    self.lbl_status.set_markup(f"<span color='#2ea043' weight='bold'>🎉 Imagem pronta: {iso_name} ({out_dir})</span>")
                    self.append_log(f"\n[SUCESSO] Imagem ISO gravada em: {iso_path}")
                    self.append_log(f"[SUCESSO] Manifesto de ROM gravado em: {manifest_path}")

                GLib.idle_add(_finish)
            except Exception as ex:
                def _error(err=str(ex)):
                    self.is_building = False
                    self.btn_compile_header.set_sensitive(True)
                    self.btn_build_now.set_sensitive(True)
                    self.btn_gen_script.set_sensitive(True)
                    self.lbl_status.set_markup(f"<span color='#f85149' weight='bold'>❌ Falha na compilação: {err}</span>")
                    self.append_log(f"❌ Erro durante compilação: {err}")
                GLib.idle_add(_error)

        threading.Thread(target=_worker, daemon=True).start()

    def on_test_in_vm(self, widget):
        profile = self.get_profile_data()
        out_dir = self.entry_out_dir.get_text().strip()
        iso_path = os.path.join(out_dir, f"{profile['id']}.iso")

        vm_bin = shutil.which("geminux-vm")
        if not vm_bin and self.project_root:
            cand = os.path.join(self.project_root, "apps/geminux-vm/geminux-vm")
            if os.path.isfile(cand):
                vm_bin = cand

        if not os.path.exists(iso_path):
            self.append_log(f"⚠️ A ISO '{profile['id']}.iso' ainda não foi compilada. Compile antes de testar na VM.")
            return

        if vm_bin:
            self.append_log(f"🖥️ Iniciando Geminux Virtual Machine com a imagem: {iso_path}...")
            try:
                subprocess.Popen([vm_bin, "--iso", iso_path])
            except Exception as e:
                self.append_log(f"❌ Erro ao abrir Geminux VM: {e}")
        else:
            self.append_log("⚠️ Binário da Geminux Virtual Machine não encontrado.")


