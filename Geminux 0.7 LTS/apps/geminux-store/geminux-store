    def filter_apps(self):
        """Filtra o catálogo de acordo com busca e categoria ativa"""
        for child in self.apps_flow.get_children():
            self.apps_flow.remove(child)

        matched = []
        for app in BUILTIN_CATALOG:
            # Filtro por busca
            if self.search_query:
                q = self.search_query
                in_name = q in app["name"].lower()
                in_desc = q in app["description"].lower()
                in_pkg = q in app["package"].lower()
                if not (in_name or in_desc or in_pkg):
                    continue

            # Filtro por categoria
            if self.current_category == "featured":
                if not app.get("featured", False):
                    continue
            elif self.current_category != "all":
                if app.get("category") != self.current_category:
                    continue

            matched.append(app)

        if not matched:
            empty_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            empty_box.set_halign(Gtk.Align.CENTER)
            empty_box.set_margin_top(48)
            empty_lbl = Gtk.Label()
            empty_lbl.set_markup("<span size='16000' color='#8b949e'>Nenhum aplicativo encontrado</span>")
            empty_box.pack_start(empty_lbl, False, False, 0)
            self.apps_flow.add(empty_box)
            self.apps_flow.show_all()
            return

        for app in matched:
            card = self.create_app_card(app)
            self.apps_flow.add(card)

        self.apps_flow.show_all()

