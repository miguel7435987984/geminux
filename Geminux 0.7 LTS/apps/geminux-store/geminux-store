    def refresh_installed_status(self):
        """Atualiza cache de status instalados em background"""
        def _check():
            new_cache = {}
            for app in BUILTIN_CATALOG:
                new_cache[app["id"]] = is_app_installed(app)
            def _apply():
                self.installed_cache = new_cache
                self.filter_apps()
                if self.view_mode == "installed":
                    self.refresh_installed_view()
            GLib.idle_add(_apply)
        threading.Thread(target=_check, daemon=True).start()

