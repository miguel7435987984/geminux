    def _pulse_progress(self):
        if hasattr(self, "status_progress") and self.status_progress.get_visible():
            self.status_progress.pulse()
            return True
        return False

    def show_status_banner(self, text, in_progress=True):
        self.status_label.set_markup(f"<span size='10500' color='{TEXT_PRIMARY}'>{GLib.markup_escape_text(text)}</span>")
        self.status_banner.show()
        self.status_label.show()
        if in_progress:
            self.status_spinner.show()
            self.status_spinner.start()
            self.status_progress.show()
            if not self.pulse_timer:
                self.pulse_timer = GLib.timeout_add(100, self._pulse_progress)
        else:
            self.status_spinner.stop()
            self.status_spinner.hide()
            self.status_progress.hide()
            if self.pulse_timer:
                GLib.source_remove(self.pulse_timer)
                self.pulse_timer = None

    def hide_status_banner(self):
        if hasattr(self, "status_banner"):
            self.status_banner.hide()
        if self.pulse_timer:
            GLib.source_remove(self.pulse_timer)
            self.pulse_timer = None
        return False

    def set_view_mode(self, mode):
