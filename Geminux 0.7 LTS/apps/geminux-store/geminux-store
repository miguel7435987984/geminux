    # -------------------------------------------------------------------------
    # Ações de Instalação, Abertura e Remoção
    # -------------------------------------------------------------------------
    def open_app(self, app):
        cmd = app.get("cmd")
        flatpak_id = app.get("flatpak_id") or (app.get("package") if "." in (app.get("package") or "") else None)
        try:
            if app.get("id") == "flutter":
                term_cmd = "prius -e 'flutter doctor; exec bash' 2>/dev/null || x-terminal-emulator -e 'bash -c \"flutter doctor; exec bash\"' || gnome-terminal -- bash -c 'flutter doctor; exec bash'"
                subprocess.Popen(term_cmd, shell=True)
            elif cmd and shutil.which(cmd):
                subprocess.Popen(cmd, shell=True)
            elif flatpak_id:
                subprocess.Popen(f"flatpak run {flatpak_id}", shell=True)
            elif cmd:
                subprocess.Popen(cmd, shell=True)
        except Exception as e:
            print(f"[GeminuxStore] Erro ao abrir {cmd}: {e}", file=sys.stderr)

    def run_install_task(self, app, cmd, action_type="install", button=None):
        """Executa processo de instalação/remoção com feedback visual em tempo real"""
        app_id = app["id"]
        app_name = app["name"]

        # 1. Registra estado no dicionário de instalações ativas
        self.installing_apps[app_id] = action_type

        # 2. Atualiza o botão da UI imediatamente
        if button:
            button.set_sensitive(False)
            if action_type == "install":
                button.set_label("⏳ Instalando...")
            else:
                button.set_label("⏳ Removendo...")
            ctx = button.get_style_context()
            ctx.remove_class("btn-primary")
            ctx.remove_class("btn-danger")
            ctx.add_class("btn-installing")

        # 3. Exibe o banner inferior com spinner e barra pulsante
        initial_msg = (
            f"Instalando {app_name}... Baixando e configurando arquivos."
            if action_type == "install"
            else f"Removendo {app_name}... Desinstalando arquivos."
        )
        self.show_status_banner(initial_msg, in_progress=True)

        # 4. Executa em background com streaming de saída
        def _worker():
            success = False
            last_line = ""
            try:
                proc = subprocess.Popen(
                    cmd,
                    shell=True,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.STDOUT,
                    text=True,
                    bufsize=1
                )
                if proc.stdout:
                    for line in iter(proc.stdout.readline, ''):
                        if not line:
                            break
                        clean_line = line.strip()
                        if clean_line:
                            last_line = clean_line
                            line_msg = clean_line
                            if len(line_msg) > 65:
                                line_msg = line_msg[:62] + "..."
                            def _update_ui(msg=line_msg):
                                if app_id in self.installing_apps:
                                    verb = "Instalando" if action_type == "install" else "Removendo"
                                    self.show_status_banner(f"{verb} {app_name}: {msg}", in_progress=True)
                            GLib.idle_add(_update_ui)
                proc.wait()
                success = (proc.returncode == 0)
            except Exception as e:
                print(f"[GeminuxStore] Erro ao executar tarefa {action_type} para {app_name}: {e}", file=sys.stderr)
                last_line = str(e)
                success = False

            def _on_finish():
                if app_id in self.installing_apps:
                    del self.installing_apps[app_id]

                self.installed_cache[app_id] = is_app_installed(app)

                if success:
                    verb_ok = "instalado com sucesso!" if action_type == "install" else "removido com sucesso!"
                    self.show_status_banner(f"✅ {app_name} {verb_ok}", in_progress=False)
                    GLib.timeout_add_seconds(4, self.hide_status_banner)
                else:
                    verb_fail = "Falha ao instalar" if action_type == "install" else "Falha ao remover"
                    err_hint = f" ({last_line})" if last_line else ""
                    self.show_status_banner(f"❌ {verb_fail} {app_name}{err_hint}", in_progress=False)
                    GLib.timeout_add_seconds(6, self.hide_status_banner)

                if self.view_mode == "installed":
                    self.refresh_installed_view()
                else:
                    self.filter_apps()

            GLib.idle_add(_on_finish)

        threading.Thread(target=_worker, daemon=True).start()

    def install_app(self, app, button=None):
        pkg = app.get("package")
        flatpak_id = app.get("flatpak_id") or (pkg if pkg and ("." in pkg or pkg.startswith("org.") or pkg.startswith("com.")) else None)
        apt_pkg = app.get("apt_package") or (pkg if pkg and "." not in pkg else None)

        # Se for o Flutter SDK
        if app.get("id") == "flutter":
            cmd = (
                "pkexec snap install flutter --classic || "
                "(pkexec git clone -b stable https://github.com/flutter/flutter.git /opt/flutter && "
                "pkexec ln -sf /opt/flutter/bin/flutter /usr/local/bin/flutter)"
            )
            self.run_install_task(app, cmd, action_type="install", button=button)
            return

        # Se for um pacote nativo Geminux deb na pasta do repo
        root_dir = os.path.abspath(os.path.join(os.path.dirname(__file__), "../.."))
        deb_candidates = [
            os.path.join(root_dir, f"apps/{app['id']}/{app['package']}_1.0.0_all.deb"),
            os.path.join(root_dir, f"apps/{app['id']}/{app['id']}_1.0.0_all.deb")
        ]
        deb_file = None
        for cand in deb_candidates:
            if os.path.exists(cand):
                deb_file = cand
                break

        if deb_file:
            cmd = f"pkexec apt-get install -y --allow-downgrades '{deb_file}' || pkexec dpkg -i '{deb_file}'"
        elif flatpak_id:
            if flatpak_id == "org.vinegarhq.Sober":
                cmd = (
                    f"flatpak install -y --noninteractive --from https://sober.vinegarhq.org/sober.flatpakref || "
                    f"flatpak install --user -y --noninteractive --from https://sober.vinegarhq.org/sober.flatpakref || "
                    f"flatpak install -y --noninteractive flathub {flatpak_id} || "
                    f"flatpak install --user -y --noninteractive flathub {flatpak_id}"
                )
            else:
                flatpak_cmd = (
                    f"flatpak install -y --noninteractive flathub {flatpak_id} || "
                    f"flatpak install --user -y --noninteractive flathub {flatpak_id}"
                )
                if apt_pkg:
                    cmd = f"{flatpak_cmd} || pkexec env DEBIAN_FRONTEND=noninteractive apt-get install -y {apt_pkg}"
                else:
                    cmd = flatpak_cmd
        elif apt_pkg:
            cmd = f"pkexec env DEBIAN_FRONTEND=noninteractive apt-get install -y {apt_pkg}"
        else:
            cmd = f"flatpak install -y --noninteractive flathub {pkg} || flatpak install --user -y --noninteractive flathub {pkg}"

        self.run_install_task(app, cmd, action_type="install", button=button)

    def uninstall_app(self, app, button=None):
        # Se for o Flutter SDK
        if app.get("id") == "flutter":
            cmd = "pkexec snap remove flutter || pkexec rm -rf /opt/flutter /usr/local/bin/flutter"
            self.run_install_task(app, cmd, action_type="uninstall", button=button)
            return

        pkg = app.get("package")
        flatpak_id = app.get("flatpak_id") or (pkg if pkg and ("." in pkg or pkg.startswith("org.") or pkg.startswith("com.")) else None)
        apt_pkg = app.get("apt_package") or (pkg if pkg and "." not in pkg else None)

        cmds = []
        if flatpak_id:
            cmds.append(f"flatpak uninstall -y --noninteractive {flatpak_id}")
        if apt_pkg:
            if apt_pkg == "vlc" or app.get("id") == "vlc":
                cmds.append("pkexec env DEBIAN_FRONTEND=noninteractive sh -c 'apt-get remove -y --purge vlc vlc-bin vlc-data vlc-plugin-* ; apt-get autoremove -y'")
            else:
                cmds.append(f"pkexec env DEBIAN_FRONTEND=noninteractive sh -c 'apt-get remove -y --purge {apt_pkg} ; apt-get autoremove -y'")
        if not cmds:
            cmds.append(f"flatpak uninstall -y --noninteractive {pkg}")

        cmd = " || ".join(cmds)
        self.run_install_task(app, cmd, action_type="uninstall", button=button)


