def is_app_installed(app):
    """Verifica se um aplicativo está instalado no sistema"""
    # 1. Verifica binário no PATH e locais comuns
    cmd = app.get("cmd")
    if cmd:
        if shutil.which(cmd):
            return True
        for extra_p in [f"/snap/bin/{cmd}", f"/opt/{cmd}/bin/{cmd}", f"/usr/local/bin/{cmd}"]:
            if os.path.exists(extra_p):
                return True

    # 2. Verifica se está instalado via Flatpak
    flatpak_id = app.get("flatpak_id") or (app.get("package") if "." in (app.get("package") or "") else None)
    if flatpak_id:
        try:
            res = subprocess.run(
                ["flatpak", "info", flatpak_id],
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                text=True
            )
            if res.returncode == 0:
                return True
        except Exception:
            pass

    # 3. Verifica pacote deb via dpkg-query
    deb_pkg = app.get("apt_package") or app.get("package")
    if deb_pkg and "." not in deb_pkg:
        try:
            res = subprocess.run(
                ["dpkg-query", "-W", "-f=${Status}", deb_pkg],
                stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL,
                text=True
            )
            if "install ok installed" in res.stdout:
                return True
        except Exception:
            pass

    return False


def run_command_async(cmd, on_done=None):
    """Executa comandos em thread separada com callback na thread principal"""
    def _worker():
        try:
            p = subprocess.Popen(cmd, shell=True)
            p.wait()
        except Exception as e:
            print(f"[GeminuxStore] Erro ao executar {cmd}: {e}", file=sys.stderr)
        if on_done:
            GLib.idle_add(on_done)
    threading.Thread(target=_worker, daemon=True).start()


