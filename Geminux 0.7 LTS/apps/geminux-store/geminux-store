    def get_icon_widget(self, app):
        """Retorna o widget de ícone do aplicativo ou fallback estilizado"""
        icon_name = app.get("icon")
        if not icon_name:
            return self._fallback_icon_widget(app)

        # 1. Prioridade Máxima: Ícones oficiais do branding Geminux (SVG / PNG vetorizados)
        base_dir = os.path.dirname(os.path.abspath(__file__))
        branding_candidates = [
            os.path.join(base_dir, f"../../branding/icons/{icon_name}.svg"),
            os.path.join(base_dir, f"../../branding/icons/{icon_name}.png"),
            os.path.join(base_dir, f"../branding/icons/{icon_name}.svg"),
            os.path.join(base_dir, f"branding/icons/{icon_name}.svg"),
            f"/usr/share/geminux/branding/icons/{icon_name}.svg",
            f"/usr/share/geminux/branding/icons/{icon_name}.png",
            f"/usr/share/icons/hicolor/scalable/apps/{icon_name}.svg",
            f"/usr/share/icons/Yaru/scalable/apps/{icon_name}.svg",
            f"/usr/share/pixmaps/{icon_name}.svg",
        ]
        for p in branding_candidates:
            if os.path.isfile(p):
                try:
                    pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(p, 48, 48, True)
                    return Gtk.Image.new_from_pixbuf(pb)
                except Exception:
                    pass

        # 2. Ícone do tema do sistema (Gtk.IconTheme)
        theme = Gtk.IconTheme.get_default()
        if theme.has_icon(icon_name):
            try:
                info = theme.lookup_icon(icon_name, 48, 0)
                if info:
                    pb = info.load_icon()
                    return Gtk.Image.new_from_pixbuf(pb)
                return Gtk.Image.new_from_icon_name(icon_name, Gtk.IconSize.DIALOG)
            except Exception:
                pass

        # 3. Fallbacks em /usr/share/pixmaps
        system_pixmaps = [
            f"/usr/share/pixmaps/{icon_name}.png",
            f"/usr/share/icons/hicolor/48x48/apps/{icon_name}.png"
        ]
        for p in system_pixmaps:
            if os.path.isfile(p):
                try:
                    pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(p, 48, 48, True)
                    return Gtk.Image.new_from_pixbuf(pb)
                except Exception:
                    pass

        # 4. Fallback para Emoji / Símbolo
        return self._fallback_icon_widget(app)

    def _fallback_icon_widget(self, app):
        box = Gtk.Box()
        box.set_size_request(48, 48)
        lbl = Gtk.Label()
        lbl.set_markup(f"<span size='24000'>{app.get('icon_fallback', '📦')}</span>")
        box.pack_start(lbl, True, True, 0)
        return box

