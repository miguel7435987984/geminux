def launch_app(cmd):
    """Executa um comando ou aplicativo de forma assíncrona e segura"""
    try:
        subprocess.Popen(cmd, shell=True)
    except Exception as e:
        print(f"[GeminuxWelcome] Erro ao abrir {cmd}: {e}", file=sys.stderr)


