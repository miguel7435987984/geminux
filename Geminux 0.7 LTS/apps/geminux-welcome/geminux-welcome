    def is_autostart_enabled(self):
        """Verifica se o início automático do Geminux Welcome está ativo"""
        if os.path.exists(AUTOSTART_FILE):
            try:
                with open(AUTOSTART_FILE, "r") as f:
                    content = f.read()
                    if "X-GNOME-Autostart-enabled=false" in content or "Hidden=true" in content:
                        return False
            except Exception:
                pass
        return True

    def on_autostart_toggled(self, button):
        """Ativa ou desativa a inicialização do Geminux Welcome"""
        enabled = button.get_active()
        os.makedirs(AUTOSTART_DIR, exist_ok=True)
        desktop_content = f"""[Desktop Entry]
Type=Application
Name=Geminux Welcome
Comment=Centro Oficial de Boas-Vindas & Tour do Geminux OS
Exec=geminux-welcome
Icon=geminux-welcome
Terminal=false
Categories=Utility;Settings;
X-GNOME-Autostart-enabled={'true' if enabled else 'false'}
Hidden={'false' if enabled else 'true'}
"""
        try:
            with open(AUTOSTART_FILE, "w") as f:
                f.write(desktop_content)
        except Exception as e:
            print(f"[GeminuxWelcome] Erro ao gravar autostart: {e}", file=sys.stderr)

