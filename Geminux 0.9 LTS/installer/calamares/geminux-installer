#!/usr/bin/env bash
# Geminux Installer Launch Wrapper

# Grant root access to current display server (Wayland and X11) silently
xhost +local:root >/dev/null 2>&1 || true
xhost +SI:localuser:root >/dev/null 2>&1 || true

# Force Qt to X11/XWayland for maximum compatibility across VMs and hardware
export QT_QPA_PLATFORM="xcb;wayland"
export QT_AUTO_SCREEN_SCALE_FACTOR=1
export BROWSER=firefox

# Determine writable log file location to avoid permission errors
LOG_FILE="/var/log/calamares.log"
if ! touch "${LOG_FILE}" 2>/dev/null; then
    LOG_FILE="/tmp/calamares.log"
fi

# Execute Calamares with debug logs
# Prioritize pkexec only if it has valid SUID permissions; fallback to sudo or direct execution
if [ -u /usr/bin/pkexec ] && pkexec --version >/dev/null 2>&1; then
    pkexec env DISPLAY="${DISPLAY}" WAYLAND_DISPLAY="${WAYLAND_DISPLAY}" XAUTHORITY="${XAUTHORITY}" calamares -d "$@" 2>&1 | tee "${LOG_FILE}" || sudo -E calamares -d "$@" 2>&1 | tee -a "${LOG_FILE}" || calamares -d "$@" 2>&1 | tee -a "${LOG_FILE}"
elif [ -u /usr/bin/sudo ] && sudo -n true >/dev/null 2>&1; then
    sudo -E calamares -d "$@" 2>&1 | tee "${LOG_FILE}" || calamares -d "$@" 2>&1 | tee -a "${LOG_FILE}"
else
    sudo -E calamares -d "$@" 2>&1 | tee "${LOG_FILE}" || calamares -d "$@" 2>&1 | tee -a "${LOG_FILE}"
fi
