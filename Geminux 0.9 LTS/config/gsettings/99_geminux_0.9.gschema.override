# ==============================================================================
# Geminux OS 0.9 LTS (Ubuntu 25.10 Kanguru) GNOME Default Settings (Maximum Priority Override)
# ==============================================================================

[org.gnome.desktop.interface]
gtk-theme='Adwaita-dark'
icon-theme='Yaru-blue'
cursor-theme='Yaru'
font-name='Ubuntu 11'
document-font-name='Ubuntu 11'
monospace-font-name='Monospace 11'
color-scheme='prefer-dark'

[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/geminux/geminux-default.png'
picture-uri-dark='file:///usr/share/backgrounds/geminux/geminux-default.png'
picture-options='zoom'
primary-color='#0f141c'
secondary-color='#000000'

[org.gnome.desktop.screensaver]
picture-uri='file:///usr/share/backgrounds/geminux/geminux-default.png'

# Regra de Interface: Prius Terminal como padrão na barra de tarefas (taskbar)
[org.gnome.shell]
favorite-apps=['firefox.desktop', 'geminux-terminal.desktop', 'prius-terminal.desktop', 'geminux-ai.desktop', 'geminux-store.desktop', 'geminux-virtual-machine.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.SystemMonitor.desktop']

[org.gnome.shell.ubuntu]
color-scheme='prefer-dark'

[org.gnome.login-screen]
logo='/usr/share/pixmaps/ubuntu-logo.svg'

[org.gnome.desktop.wm.preferences]
button-layout='appmenu:minimize,maximize,close'
theme='Adwaita-dark'

[com.ubuntu.update-notifier]
no-show-notifications=true
show-updates-status-icon=false
regular-auto-launch-interval=999999
show-apport-crashes=false

[com.ubuntu.update-manager]
check-dist-upgrades=false
first-run=false

[org.gnome.software]
official-repos=['geminux', 'geminux-*', 'geminux-repo', 'ubuntu', 'ubuntu-*', 'flathub', 'local', '*']
required-repos=['geminux', 'ubuntu']
compatible-projects=['GNOME', 'KDE', 'XFCE', 'Geminux']
allow-updates=false
download-updates=false
download-updates-notify=false
