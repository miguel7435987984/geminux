#!/usr/bin/env bash
# ==============================================================================
# Geminux OS - VMware Workstation Pro / Player Helper & Launcher
# ==============================================================================

set -e

if [ -x "$(command -v vmware)" ]; then
    exec vmware "$@"
elif [ -x "$(command -v vmplayer)" ]; then
    exec vmplayer "$@"
else
    # Check if pkexec is available for GUI password prompt
    zenity_or_notify() {
        if [ -x "$(command -v zenity)" ]; then
            zenity --info --title="Geminux - VMware Workstation" --text="Para instalar o VMware Workstation Pro no Geminux:\n\n1. O VMware oficial (.bundle) é gratuito para uso pessoal.\n2. Você pode baixar diretamente pelo navegador ou executar a instalação automática.\n\nAbrindo a página oficial de download..." --width=450 2>/dev/null || true
        fi
    }

    zenity_or_notify
    if [ -x "$(command -v xdg-open)" ]; then
        xdg-open "https://www.vmware.com/products/desktop-hypervisors/workstation-and-fusion" &
    fi
fi
