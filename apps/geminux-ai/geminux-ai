            header_lbl.set_halign(Gtk.Align.START)
            bubble.pack_start(header_lbl, False, False, 0)
        else:
            bubble.get_style_context().add_class("chat-msg-ai")
            row.set_halign(Gtk.Align.START)
            header_lbl = Gtk.Label()
            header_lbl.set_markup(f"<span foreground='{ACCENT_CYAN}'><b>💎 Geminux AI</b></span>")
            header_lbl.set_halign(Gtk.Align.START)
            bubble.pack_start(header_lbl, False, False, 0)

        content_lbl = Gtk.Label()
        content_lbl.set_markup(text)
        content_lbl.set_line_wrap(True)
        content_lbl.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
        content_lbl.set_max_width_chars(65)
        content_lbl.set_halign(Gtk.Align.START)
        content_lbl.set_selectable(True)
        bubble.pack_start(content_lbl, True, True, 0)

        row.pack_start(bubble, True, True, 0)
        self.messages_box.pack_start(row, False, False, 0)
        self.messages_box.show_all()

        # Rola suavemente para a última mensagem
        GLib.idle_add(self.scroll_to_bottom)

    def scroll_to_bottom(self):
        adj = self.scrolled.get_vadjustment()
        adj.set_value(adj.get_upper() - adj.get_page_size())
        return False

    def on_send_clicked(self, _btn):
        text = self.entry.get_text().strip()
        if not text:
            return
        self.entry.set_text("")
        self.send_message(text)

    def send_message(self, text):
        self.add_message_bubble("user", GLib.markup_escape_text(text))

        # Indicador de digitação
        thinking_bubble = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        thinking_bubble.get_style_context().add_class("chat-msg-ai")
        t_lbl = Gtk.Label()
        t_lbl.set_markup(f"<i>Geminux AI está pensando...</i>")
        thinking_bubble.pack_start(t_lbl, False, False, 0)
        self.messages_box.pack_start(thinking_bubble, False, False, 0)
        self.messages_box.show_all()
        self.scroll_to_bottom()

        threading.Thread(target=self.process_ai_response, args=(text, thinking_bubble), daemon=True).start()

    def process_ai_response(self, prompt, thinking_widget):
        api_key = self.settings.get("api_key", "").strip()

        if api_key:
            response = self.query_online_gemini(prompt, api_key)
        else:
            response = self.query_offline_knowledge(prompt)

        GLib.idle_add(self.finish_response, thinking_widget, response)

    def finish_response(self, thinking_widget, response_text):
        self.messages_box.remove(thinking_widget)
        self.add_message_bubble("ai", response_text)

    def query_offline_knowledge(self, prompt):
        p_lower = prompt.lower()
        for key, ans in OFFLINE_KNOWLEDGE_BASE.items():
            if key in p_lower:
                return (
                    f"{ans}\n\n"
                    f"<small><span foreground='{TEXT_MUTED}'>💡 Resposta do Motor Offline do Geminux OS. "
                    f"Para respostas gerais na nuvem, configure sua chave de API nas configurações.</span></small>"
                )

        # Resposta padrão inteligente do modo offline
        return (
            f"Comando ou dúvida reconhecida no Geminux OS:\n\n"
            f"• Você pode executar e testar tarefas usando o <b>Prius Terminal</b>.\n"
            f"• Para gerenciar pacotes: <code>sudo apt install &lt;pacote&gt;</code>\n"
            f"• Para virtualizar outros sistemas: abra o <b>Geminux Virtual Machine</b>.\n\n"
            f"<i>Dica: Você pode conectar a API do Gemini ou Groq no botão de configurações no topo para respostas ilimitadas de IA na nuvem!</i>"
        )

    def query_online_gemini(self, prompt, api_key):
        url = f"https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent?key={api_key}"
        headers = {"Content-Type": "application/json"}
        payload = {
            "contents": [{
                "parts": [{"text": f"Você é a Geminux AI, assistente inteligente oficial do sistema operacional Geminux OS. Responda de forma clara, amigável e precisa em português:\n\nPergunta: {prompt}"}]
            }]
        }

        try:
            req = urllib.request.Request(url, data=json.dumps(payload).encode('utf-8'), headers=headers, method="POST")
            with urllib.request.urlopen(req, timeout=15) as resp:
                data = json.loads(resp.read().decode('utf-8'))
                candidates = data.get("candidates", [])
                if candidates:
                    parts = candidates[0].get("content", {}).get("parts", [])
                    if parts:
                        return GLib.markup_escape_text(parts[0].get("text", "")).replace("\n", "\n")
            return "Recebi uma resposta vazia dos servidores da nuvem."
        except urllib.error.HTTPError as e:
            return f"<b>Erro de Conexão com a API:</b> Código {e.code}. Verifique se a sua chave de API é válida nas configurações."
        except Exception as e:
            return f"<b>Falha de conexão:</b> {str(e)}\n\nUsando base de conhecimento offline do Geminux."

    def open_settings_dialog(self, _btn):
        dialog = Gtk.Dialog(title="Configurações da Geminux AI", transient_for=self, modal=True)
        dialog.set_default_size(480, 260)
        dialog.set_position(Gtk.WindowPosition.CENTER)

        content = dialog.get_content_area()
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        box.set_margin_top(16)
        box.set_margin_bottom(16)
        box.set_margin_start(20)
        box.set_margin_end(20)
        content.pack_start(box, True, True, 0)

        title = Gtk.Label()
        title.set_markup("<b>Provedor de Inteligência Artificial</b>")
        title.set_halign(Gtk.Align.START)
        box.pack_start(title, False, False, 0)

        desc = Gtk.Label()
        desc.set_markup(
            f"<span foreground='{TEXT_MUTED}'>"
            "A Geminux AI funciona 100% offline para comandos e dúvidas do sistema. "
            "Se desejar respostas ilimitadas com modelos avançados na nuvem (Google Gemini), "
            "insira sua Chave de API abaixo:</span>"
        )
        desc.set_line_wrap(True)
        desc.set_halign(Gtk.Align.START)
        box.pack_start(desc, False, False, 0)

        key_entry = Gtk.Entry()
        key_entry.set_placeholder_text("Chave de API (ex: AIzaSy...)")
        key_entry.set_text(self.settings.get("api_key", ""))
        key_entry.set_visibility(False)
        box.pack_start(key_entry, False, False, 0)

        dialog.add_button("Cancelar", Gtk.ResponseType.CANCEL)
        dialog.add_button("Salvar Configurações", Gtk.ResponseType.OK)
        dialog.show_all()

        response = dialog.run()
        if response == Gtk.ResponseType.OK:
            self.settings["api_key"] = key_entry.get_text().strip()
            save_settings(self.settings)
            mode_text = "Modo Conectado (API)" if self.settings.get("api_key") else "Modo Especialista Offline"
            self.sidebar_status.set_markup(f"<small><span foreground='{TEXT_MUTED}'>Status: {mode_text}</span></small>")
        dialog.destroy()


def main():
    win = GeminuxAIWindow()
    win.connect("destroy", Gtk.main_quit)
    win.show_all()
    Gtk.main()

if __name__ == "__main__":
    main()
