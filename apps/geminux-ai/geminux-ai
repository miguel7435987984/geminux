        p_lower = prompt.lower()
        if "ios" in p_lower or "swift" in p_lower or "apple" in p_lower:
            return OFFLINE_CODEF_TEMPLATES["ios"]
        elif "geminux" in p_lower or "linux" in p_lower or "desktop" in p_lower:
            return OFFLINE_CODEF_TEMPLATES["geminux"]
        else:
            return OFFLINE_CODEF_TEMPLATES["android"]

    def query_gemini(self, prompt, api_key, model, system_prompt):
        url = f"https://generativelanguage.googleapis.com/v1beta/models/{model}:generateContent?key={api_key}"
        headers = {"Content-Type": "application/json"}
        payload = {
            "contents": [{
                "parts": [{"text": f"{system_prompt}\n\nUsuário solicitou:\n{prompt}"}]
            }]
        }

        try:
            req = urllib.request.Request(url, data=json.dumps(payload).encode('utf-8'), headers=headers, method="POST")
            with urllib.request.urlopen(req, timeout=30) as resp:
                data = json.loads(resp.read().decode('utf-8'))
                candidates = data.get("candidates", [])
                if candidates:
                    parts = candidates[0].get("content", {}).get("parts", [])
                    if parts:
                        return parts[0].get("text", "")
            return "Nenhuma resposta recebida do servidor Gemini."
        except urllib.error.HTTPError as e:
            err_msg = self.extract_error_detail(e)
            return f"<b>Erro no Google Gemini (HTTP {e.code}):</b>\n{err_msg}\n\nVerifique sua chave de API nas configurações."
        except Exception as e:
            return f"<b>Falha de conexão com Gemini:</b> {str(e)}"

    def query_openai_compatible(self, prompt, api_key, model, endpoint, provider_name, system_prompt):
        headers = {
            "Content-Type": "application/json",
            "Authorization": f"Bearer {api_key}"
        }
        payload = {
            "model": model,
            "messages": [
                {"role": "system", "content": system_prompt},
                {"role": "user", "content": prompt}
            ],
            "stream": False
        }

        try:
            req = urllib.request.Request(endpoint, data=json.dumps(payload).encode('utf-8'), headers=headers, method="POST")
            with urllib.request.urlopen(req, timeout=35) as resp:
                data = json.loads(resp.read().decode('utf-8'))
                choices = data.get("choices", [])
                if choices:
                    return choices[0].get("message", {}).get("content", "")
            return f"Nenhuma resposta recebida do servidor {provider_name}."
        except urllib.error.HTTPError as e:
            err_msg = self.extract_error_detail(e)
            return f"<b>Erro no {provider_name} (HTTP {e.code}):</b>\n{err_msg}\n\nVerifique sua chave de API nas configurações."
        except Exception as e:
            return f"<b>Falha de conexão com {provider_name}:</b> {str(e)}"

    def extract_error_detail(self, http_error):
        try:
            body = http_error.read().decode('utf-8', errors='ignore')
            data = json.loads(body)
            if "error" in data:
                err = data["error"]
                if isinstance(err, dict) and "message" in err:
                    return err["message"]
                return str(err)
            return body[:200]
        except Exception:
            return "Erro desconhecido na resposta do servidor."

