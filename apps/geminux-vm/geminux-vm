CONFIG_DIR = os.path.expanduser("~/.config/geminux-vm")
DATA_DIR = os.path.expanduser("~/.local/share/geminux-vm")
DISKS_DIR = os.path.join(DATA_DIR, "disks")
VMS_FILE = os.path.join(CONFIG_DIR, "vms.json")

class VMManager:
    """Gerencia a lista de configurações e processos de VMs"""
    def __init__(self):
        os.makedirs(CONFIG_DIR, exist_ok=True)
        os.makedirs(DISKS_DIR, exist_ok=True)
        self.vms = self.load_vms()
        self.running_processes = {} # vm_id -> subprocess.Popen
        self.start_times = {} # vm_id -> float timestamp
        self.is_paused = {} # vm_id -> bool
        self.process_logs = {} # vm_id -> list of str
        self.console_windows = {} # vm_id -> VMConsoleWindow

    def append_log(self, vm_id, text):
        if vm_id not in self.process_logs:
            self.process_logs[vm_id] = []
        self.process_logs[vm_id].append(text)

    def get_logs(self, vm_id):
        return self.process_logs.get(vm_id, [])

    def qmp_command(self, vm_id, command, arguments=None):
        sock_path = os.path.join(CONFIG_DIR, f"qmp_{vm_id}.sock")
        if not os.path.exists(sock_path):
            return False, "Soquete QMP não encontrado."
        try:
            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            s.settimeout(2.0)
            s.connect(sock_path)
            s.recv(2048) # greeting
            s.sendall(json.dumps({"execute": "qmp_capabilities"}).encode() + b"\n")
            s.recv(2048)
            payload = {"execute": command}
            if arguments:
                payload["arguments"] = arguments
            s.sendall(json.dumps(payload).encode() + b"\n")
            res = json.loads(s.recv(4096).decode())
            s.close()
            return True, res
        except Exception as e:
            return False, str(e)

    def pause_vm(self, vm_id):
        ok, _ = self.qmp_command(vm_id, "stop")
        if ok:
            self.is_paused[vm_id] = True
        return ok

    def resume_vm(self, vm_id):
        ok, _ = self.qmp_command(vm_id, "cont")
        if ok:
            self.is_paused[vm_id] = False
        return ok

    def reset_vm(self, vm_id):
        return self.qmp_command(vm_id, "system_reset")[0]

    def powerdown_vm(self, vm_id):
        return self.qmp_command(vm_id, "system_powerdown")[0]

    def send_ctrl_alt_del(self, vm_id):
        return self.qmp_command(vm_id, "send-key", {
            "keys": [
                {"type": "qcode", "data": "ctrl"},
                {"type": "qcode", "data": "alt"},
                {"type": "qcode", "data": "delete"}
            ]
        })[0]

    def take_screenshot(self, vm_id, dest_file):
        ppm_file = os.path.join(CONFIG_DIR, f"temp_{vm_id}.ppm")
        if os.path.exists(ppm_file):
            try:
                os.remove(ppm_file)
            except Exception:
                pass
        ok, _ = self.qmp_command(vm_id, "screendump", {"filename": ppm_file})
        if ok and os.path.exists(ppm_file):
            try:
                pixbuf = GdkPixbuf.Pixbuf.new_from_file(ppm_file)
                pixbuf.savev(dest_file, "png", [], [])
                os.remove(ppm_file)
                return True
            except Exception:
                try:
                    shutil.move(ppm_file, dest_file)
                    return True
                except Exception:
                    pass
        return False

    def load_vms(self):
        if os.path.exists(VMS_FILE):
            try:
                with open(VMS_FILE, "r", encoding="utf-8") as f:
                    return json.load(f)
            except Exception as e:
                print(f"Erro ao carregar VMs: {e}")
        return []

    def save_vms(self):
        try:
            with open(VMS_FILE, "w", encoding="utf-8") as f:
                json.dump(self.vms, f, indent=2, ensure_ascii=False)
        except Exception as e:
            print(f"Erro ao salvar VMs: {e}")

    def add_vm(self, vm_data):
        self.vms.append(vm_data)
        self.save_vms()

    def remove_vm(self, vm_id, delete_disk=False):
        vm = self.get_vm(vm_id)
        if vm:
            if self.is_running(vm_id):
                self.stop_vm(vm_id, force=True)
            if delete_disk and "disk_path" in vm and os.path.exists(vm["disk_path"]):
                try:
                    os.remove(vm["disk_path"])
                except Exception as e:
                    print(f"Erro ao deletar disco: {e}")
            self.vms = [v for v in self.vms if v["id"] != vm_id]
            self.save_vms()

    def get_vm(self, vm_id):
        for vm in self.vms:
            if vm["id"] == vm_id:
                return vm
        return None

    def update_vm(self, vm_id, new_data):
        for i, vm in enumerate(self.vms):
            if vm["id"] == vm_id:
                self.vms[i].update(new_data)
                self.save_vms()
                break

    def is_running(self, vm_id):
        proc = self.running_processes.get(vm_id)
        if proc:
            if proc.poll() is None:
                return True
            else:
                del self.running_processes[vm_id]
        return False

    def start_vm(self, vm_id):
        if self.is_running(vm_id):
            return True, "A máquina já está em execução."

        vm = self.get_vm(vm_id)
        if not vm:
            return False, "Máquina virtual não encontrada."

        # Monta os argumentos do QEMU com base no Sistema Operacional e Motor de Virtualização
        os_type = vm.get("os_type", "linux").lower()
        engine = vm.get("engine", "kvm").lower()
        disk_format = vm.get("disk_format")
        disk_path = vm.get("disk_path")
        if not disk_format and disk_path:
            if disk_path.endswith(".vdi"):
                disk_format = "vdi"
            elif disk_path.endswith(".vmdk"):
                disk_format = "vmdk"
            else:
                disk_format = "qcow2"
        elif not disk_format:
            disk_format = "qcow2"

        # Verifica se KVM está disponível e com permissão no sistema
        has_kvm = os.path.exists("/dev/kvm") and os.access("/dev/kvm", os.R_OK | os.W_OK)
        cmd = ["qemu-system-x86_64"]
        if has_kvm:
            cmd.append("-enable-kvm")
            default_cpu = "host"
        else:
            default_cpu = "qemu64"

        # Memória, CPUs e Barramento USB
        ram_mb = vm.get("ram_mb", 2048)
        cpus = vm.get("cpus", 2)
        cmd.extend(["-m", f"{ram_mb}M", "-smp", str(cpus), "-usb"])

        # Configurações Específicas por Motor e Sistema Operacional
        macos_cpu = "host,vendor=GenuineIntel" if has_kvm else "qemu64,vendor=GenuineIntel"
        win_cpu = "host,hv_relaxed,hv_spinlocks=0x1fff,hv_vapic,hv_time" if has_kvm else "qemu64"

        if engine == "virtualbox":
            # Perfil de Compatibilidade Oracle VM VirtualBox
            if os_type == "windows":
                cmd.extend([
                    "-cpu", win_cpu,
                    "-vga", "std",
                    "-device", "usb-tablet"
                ])
            elif os_type == "macos":
                cmd.extend([
                    "-machine", "q35",
                    "-cpu", macos_cpu,
                    "-vga", "std",
                    "-device", "usb-tablet",
                    "-device", "isa-applesmc,osk=ourhardworkbythesewordsguardedpleasedontsteal(c)AppleComputerInc"
                ])
            else: # Linux
                cmd.extend([
                    "-cpu", default_cpu,
                    "-vga", "std",
                    "-device", "usb-tablet"
                ])
        elif engine == "vmware":
            # Perfil de Compatibilidade VMware Workstation
            if os_type == "windows":
                cmd.extend([
                    "-cpu", win_cpu,
                    "-vga", "vmware",
                    "-device", "usb-tablet"
                ])
            elif os_type == "macos":
                cmd.extend([
                    "-machine", "q35",
                    "-cpu", macos_cpu,
                    "-vga", "vmware",
                    "-device", "usb-tablet",
                    "-device", "isa-applesmc,osk=ourhardworkbythesewordsguardedpleasedontsteal(c)AppleComputerInc"
                ])
            else: # Linux
                cmd.extend([
                    "-cpu", default_cpu,
                    "-vga", "vmware",
                    "-device", "usb-tablet"
                ])
        else:
            # Perfil Nativo KVM / Hyper-V
            if os_type == "windows":
                # Otimizações completas Hyper-V para Windows
                cmd.extend([
                    "-cpu", win_cpu,
                    "-vga", "virtio",
                    "-device", "usb-tablet"
                ])
            elif os_type == "macos":
                # Configuração recomendada para macOS (q35, CPU compatível e gráficos vmware)
                cmd.extend([
                    "-machine", "q35",
                    "-cpu", macos_cpu,
                    "-vga", "vmware",
                    "-device", "usb-tablet",
                    "-device", "isa-applesmc,osk=ourhardworkbythesewordsguardedpleasedontsteal(c)AppleComputerInc"
                ])
            else: # Linux
                cmd.extend([
                    "-cpu", default_cpu,
                    "-vga", "virtio",
                    "-device", "usb-tablet"
                ])

        # Configuração de Firmware / BIOS: SeaBIOS (x86 padrão / legado) vs UEFI (OVMF)
        bios_type = vm.get("bios_type", "seabios").lower()
        if bios_type in ("ovmf", "uefi"):
            ovmf_paths = [
                "/usr/share/OVMF/OVMF_CODE.fd",
                "/usr/share/qemu/OVMF.fd",
                "/usr/share/ovmf/OVMF.fd"
            ]
            ovmf_found = False
            for p in ovmf_paths:
                if os.path.exists(p):
                    cmd.extend(["-bios", p])
                    ovmf_found = True
                    break
            if not ovmf_found:
                bios_type = "seabios"

        if bios_type == "seabios":
            # SeaBIOS: BIOS padrão e de máxima compatibilidade x86
            seabios_paths = [
                "/usr/share/seabios/bios-256k.bin",
                "/usr/share/seabios/bios.bin",
                "/usr/share/qemu/bios-256k.bin",
                "/usr/share/qemu/bios.bin"
            ]
            for p in seabios_paths:
                if os.path.exists(p):
                    cmd.extend(["-bios", p])
                    break

        # Identidade Visual e Interface Gráfica Geminux OS (Sem barra de menus do QEMU)
        vm_name = vm.get("name", "Máquina Virtual")
        cmd.extend([
            "-name", f"{vm_name} - Geminux Virtual Machine,process=geminux-vm",
            "-display", "gtk,show-menubar=off,zoom-to-fit=on"
        ])

        # Soquete QMP para controle integrado de energia, teclas e snapshots
        qmp_sock = os.path.join(CONFIG_DIR, f"qmp_{vm_id}.sock")
        if os.path.exists(qmp_sock):
            try:
                os.remove(qmp_sock)
            except Exception:
                pass
        cmd.extend(["-qmp", f"unix:{qmp_sock},server,nowait"])

        # Disco rígido virtual (suporte a .qcow2, .vdi e .vmdk)
        if disk_path and os.path.exists(disk_path):
            if engine == "kvm" and os_type == "linux":
                cmd.extend(["-drive", f"file={disk_path},format={disk_format},if=virtio"])
            else:
                cmd.extend(["-drive", f"file={disk_path},format={disk_format}"])

        # Mídia de instalação ISO
        iso_path = vm.get("iso_path")
        if iso_path and os.path.exists(iso_path):
            cmd.extend(["-cdrom", iso_path, "-boot", "d"])
        else:
            cmd.extend(["-boot", "c"])

        # Áudio e Rede Segura
        nic_model = "virtio" if (engine == "kvm" and os_type == "linux") else "e1000"
        cmd.extend(["-nic", f"user,model={nic_model}"])

        # Detecta disponibilidade de som sem abortar o QEMU se ausente
        pulse_sock = f"/run/user/{os.getuid()}/pulse/native"
        pipewire_sock = f"/run/user/{os.getuid()}/pipewire-0"
        if os.path.exists(pulse_sock) or os.environ.get("PULSE_SERVER"):
            cmd.extend([
                "-audiodev", "pa,id=snd0",
                "-device", "ich9-intel-hda",
                "-device", "hda-output,audiodev=snd0"
            ])
        elif os.path.exists(pipewire_sock):
            cmd.extend([
                "-audiodev", "pipewire,id=snd0",
                "-device", "ich9-intel-hda",
                "-device", "hda-output,audiodev=snd0"
            ])

        self.process_logs[vm_id] = []
        self.append_log(vm_id, f"=== Iniciando {vm_name} ({os_type.capitalize()}) no Geminux Virtual Machine ===")
        firmware_label = "UEFI (OVMF)" if bios_type in ("ovmf", "uefi") else "SeaBIOS (x86 Padrão)"
        self.append_log(vm_id, f"Motor: {engine.upper()} | Firmware: {firmware_label} | RAM: {ram_mb}MB | CPUs: {cpus}")
        self.append_log(vm_id, f"Aceleração KVM: {'Ativa (Hardware nativo)' if has_kvm else 'Desativada (Modo de emulação segura)'}")
        if disk_path:
            self.append_log(vm_id, f"Disco: {disk_path} ({disk_format})")
        if iso_path:
            self.append_log(vm_id, f"Mídia ISO: {iso_path}")

        try:
            proc = subprocess.Popen(
                cmd,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                bufsize=1
            )

            # Leitura assíncrona de logs sem travar pipes
            def stream_reader(pipe, is_err=False):
                try:
                    for line in iter(pipe.readline, ''):
                        if not line:
                            break
                        clean_line = line.strip()
                        if clean_line:
                            prefix = "⚠️ " if is_err else "ℹ️ "
                            self.append_log(vm_id, f"{prefix}{clean_line}")
                except Exception:
                    pass
                finally:
                    try:
                        pipe.close()
                    except Exception:
                        pass

            t_out = threading.Thread(target=stream_reader, args=(proc.stdout, False), daemon=True)
            t_err = threading.Thread(target=stream_reader, args=(proc.stderr, True), daemon=True)
            t_out.start()
            t_err.start()

            # Aguarda um curto intervalo para verificar inicialização
            time.sleep(0.5)
            if proc.poll() is not None:
                err_output = "\n".join(self.process_logs.get(vm_id, []))
                if "Cannot allocate memory" in err_output or "cannot set up guest memory" in err_output:
                    err_output += "\n\n💡 Dica Geminux: A memória RAM configurada para esta máquina é superior à memória livre do computador. Experimente reduzir para 1024 MB ou 1536 MB."
                return False, f"O motor de virtualização encerrou inesperadamente:\n\n{err_output}"

            self.running_processes[vm_id] = proc
            self.start_times[vm_id] = time.time()
            self.is_paused[vm_id] = False
            self.append_log(vm_id, "🟢 Máquina virtual iniciada com sucesso.")
            return True, "Máquina virtual iniciada com sucesso."
        except Exception as e:
            return False, f"Falha ao executar máquina virtual: {str(e)}"

    def stop_vm(self, vm_id, force=False):
        proc = self.running_processes.get(vm_id)
        if proc and proc.poll() is None:
            self.append_log(vm_id, "Desligando máquina virtual...")
            if not force:
                self.powerdown_vm(vm_id)
                for _ in range(15):
                    if proc.poll() is not None:
                        break
                    time.sleep(0.1)

            if proc.poll() is None:
                if force:
                    proc.kill()
                else:
                    proc.terminate()

            if vm_id in self.running_processes:
                del self.running_processes[vm_id]
            self.append_log(vm_id, "⚪ Máquina virtual desligada.")
            qmp_sock = os.path.join(CONFIG_DIR, f"qmp_{vm_id}.sock")
            if os.path.exists(qmp_sock):
                try:
                    os.remove(qmp_sock)
                except Exception:
                    pass
            return True
        return False


def get_safe_system_ram():
    """Detecta a memória física total do host para sugerir valores seguros de RAM e evitar estouro de memória"""
    try:
        pages = os.sysconf('SC_PHYS_PAGES')
        page_size = os.sysconf('SC_PAGE_SIZE')
        total_ram_mb = (pages * page_size) // (1024 * 1024)
    except Exception:
        total_ram_mb = 4096

    if total_ram_mb <= 2048:
        return {"total": total_ram_mb, "linux": 512, "windows": 1024, "macos": 1024}
    elif total_ram_mb <= 4096:
        # Host ou QEMU com 4GB ou menos: evita alocar 4GB na VM interna
        return {"total": total_ram_mb, "linux": 1024, "windows": 1536, "macos": 1536}
    elif total_ram_mb <= 8192:
        return {"total": total_ram_mb, "linux": 2048, "windows": 2048, "macos": 2048}
    else:
        return {"total": total_ram_mb, "linux": 2048, "windows": 4096, "macos": 4096}


class VMConsoleWindow(Gtk.Window):
    """Janela Oficial de Console e Execução do Geminux Virtual Machine"""
    def __init__(self, manager, vm_id, parent=None):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.manager = manager
        self.vm_id = vm_id
        self.vm = manager.get_vm(vm_id) or {}
        self.elapsed_seconds = int(time.time() - self.manager.start_times.get(vm_id, time.time()))
        vm_name = self.vm.get("name", "Máquina Virtual")

        self.set_title(f"{vm_name} - Geminux Virtual Machine")
        self.set_wmclass("geminux-virtual-machine", "Geminux Virtual Machine")
        self.set_default_size(780, 560)
        self.set_position(Gtk.WindowPosition.CENTER)

        # HeaderBar Oficial Geminux OS
