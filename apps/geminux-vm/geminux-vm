    def refresh_vm_list(self):
        for child in self.vm_listbox.get_children():
            self.vm_listbox.remove(child)

        vms = self.manager.vms
        if not vms:
            self.empty_state_box.show()
            self.vm_content_box.hide()
            self.current_selected_vm_id = None
            return

        for vm in vms:
            row = Gtk.ListBoxRow()
            row.vm_id = vm["id"]
            row.get_style_context().add_class("vm-row")

            h_box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)

            os_type = vm.get("os_type", "linux")
            icon_char = "🪟" if os_type == "windows" else ("🍎" if os_type == "macos" else "🐧")
            icon_lbl = Gtk.Label()
            icon_lbl.set_markup(f"<span size='x-large'>{icon_char}</span>")
            h_box.pack_start(icon_lbl, False, False, 0)

            v_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            name_lbl = Gtk.Label(label=vm.get("name", "VM"))
            name_lbl.set_halign(Gtk.Align.START)
            name_lbl.get_style_context().add_class("card-title")

            engine = vm.get("engine", "kvm")
            if engine == "virtualbox":
                engine_badge = "VirtualBox"
            elif engine == "vmware":
                engine_badge = "VMware"
            else:
                engine_badge = "Hyper-V / KVM"

            sub_text = f"{os_type.capitalize()} • {engine_badge} • {vm.get('ram_mb', 2048)}MB • {vm.get('disk_gb', 20)}GB"
            sub_lbl = Gtk.Label(label=sub_text)
            sub_lbl.set_halign(Gtk.Align.START)
            sub_lbl.get_style_context().add_class("dim-label")

            v_box.pack_start(name_lbl, False, False, 0)
            v_box.pack_start(sub_lbl, False, False, 0)
            h_box.pack_start(v_box, True, True, 0)

            status_icon = Gtk.Label()
            is_run = self.manager.is_running(vm["id"])
            status_icon.set_text("🟢" if is_run else "⚪")
            h_box.pack_end(status_icon, False, False, 0)

            row.add(h_box)
            self.vm_listbox.add(row)

        self.vm_listbox.show_all()

        # Seleciona o primeiro item por padrão se nenhum estiver selecionado
        if self.current_selected_vm_id is None:
            first_row = self.vm_listbox.get_row_at_index(0)
            if first_row:
                self.vm_listbox.select_row(first_row)
        else:
            # Mantém a seleção anterior
            for row in self.vm_listbox.get_children():
                if getattr(row, "vm_id", None) == self.current_selected_vm_id:
                    self.vm_listbox.select_row(row)
                    break

    def on_vm_row_selected(self, listbox, row):
        if not row:
            self.empty_state_box.show()
            self.vm_content_box.hide()
            self.current_selected_vm_id = None
            return

        vm_id = row.vm_id
        self.current_selected_vm_id = vm_id
        vm = self.manager.get_vm(vm_id)
        if not vm:
            return

        self.empty_state_box.hide()
        self.vm_content_box.show()

        os_type = vm.get("os_type", "linux")
        engine = vm.get("engine", "kvm")
        if engine == "virtualbox":
            engine_str = "Oracle VirtualBox (.vdi)"
            accel_str = "Compatibilidade VirtualBox (Intel e1000 / Standard VGA)"
        elif engine == "vmware":
            engine_str = "VMware Workstation (.vmdk)"
            accel_str = "Compatibilidade VMware (SVGA-II / KVM Acelerado)"
        else:
            engine_str = "KVM / Hyper-V (.qcow2)"
            accel_str = "Hyper-V Enlightenments / KVM VirtIO Acelerado"

        icon_char = "🪟" if os_type == "windows" else ("🍎" if os_type == "macos" else "🐧")
        self.header_icon_lbl.set_markup(f"<span size='xx-large'>{icon_char}</span>")
        self.vm_title_lbl.set_markup(f"<span size='x-large' weight='bold'>{vm.get('name', 'Máquina Virtual')}</span>")
        self.vm_os_lbl.set_text(f"Sistema Operacional: {os_type.capitalize()} • Motor: {engine_str}")

        self.val_engine.set_text(engine_str)
        self.val_ram.set_text(f"{vm.get('ram_mb', 2048)} MB ({vm.get('ram_mb', 2048)/1024:.1f} GB)")
        self.val_cpu.set_text(f"{vm.get('cpus', 2)} vCPUs ({accel_str})")
        self.val_disk.set_text(f"{vm.get('disk_gb', 20)} GB ({os.path.basename(vm.get('disk_path', 'disco.qcow2'))})")
        self.val_iso.set_text(vm.get("iso_path") if vm.get("iso_path") else "Nenhuma ISO montada (boot direto do disco)")
        bios_type = vm.get("bios_type", "seabios").lower()
        fw_str = "UEFI (OVMF Moderno)" if bios_type in ("ovmf", "uefi") else "SeaBIOS (x86 Padrão / Legado)"
        self.val_bios.set_text(fw_str)

        self.update_running_ui(vm_id)

    def update_running_ui(self, vm_id):
        is_run = self.manager.is_running(vm_id)
        sc = self.status_badge.get_style_context()
        if is_run:
            self.status_badge.set_text("🟢 Em Execução")
            sc.remove_class("badge-stopped")
            sc.add_class("badge-running")
            self.start_btn.set_sensitive(False)
            self.stop_btn.set_sensitive(True)
        else:
            self.status_badge.set_text("⚪ Desligada")
            sc.remove_class("badge-running")
            sc.add_class("badge-stopped")
            self.start_btn.set_sensitive(True)
            self.stop_btn.set_sensitive(False)
        self.console_btn.set_sensitive(True)

    def on_status_timer(self):
        if self.current_selected_vm_id:
            self.update_running_ui(self.current_selected_vm_id)
        # Atualiza bolinhas da lista
        for row in self.vm_listbox.get_children():
            vm_id = getattr(row, "vm_id", None)
            if vm_id:
                is_run = self.manager.is_running(vm_id)
                h_box = row.get_child()
                status_lbl = h_box.get_children()[-1]
                status_lbl.set_text("🟢" if is_run else "⚪")
        return True

    def on_new_vm_clicked(self, button):
        dialog = NewVMDialog(self)
        response = dialog.run()
        if response == Gtk.ResponseType.OK:
            data = dialog.get_data()
            vm_id = f"vm_{int(time.time())}"
            disk_fmt = data.get("disk_format", "qcow2")
            disk_filename = f"{vm_id}_{data['os_type']}.{disk_fmt}"
            disk_path = os.path.join(DISKS_DIR, disk_filename)

            # Cria o disco virtual (.qcow2, .vdi ou .vmdk) via qemu-img
            try:
                subprocess.run(
                    ["qemu-img", "create", "-f", disk_fmt, disk_path, f"{data['disk_gb']}G"],
                    check=True,
                    capture_output=True
                )
            except Exception as e:
                err_dlg = Gtk.MessageDialog(
                    transient_for=self,
                    flags=Gtk.DialogFlags.MODAL,
                    type=Gtk.MessageType.ERROR,
                    buttons=Gtk.ButtonsType.OK,
                    text="Erro ao criar disco virtual"
                )
                err_dlg.format_secondary_text(str(e))
                err_dlg.run()
                err_dlg.destroy()
                dialog.destroy()
                return

            data["id"] = vm_id
            data["disk_path"] = disk_path
            self.manager.add_vm(data)
            self.current_selected_vm_id = vm_id
            self.refresh_vm_list()

        dialog.destroy()

    def on_start_vm_clicked(self, button):
        if not self.current_selected_vm_id:
            return
        success, msg = self.manager.start_vm(self.current_selected_vm_id)
        if not success:
            err_dlg = Gtk.MessageDialog(
                transient_for=self,
                flags=Gtk.DialogFlags.MODAL,
                type=Gtk.MessageType.ERROR,
                buttons=Gtk.ButtonsType.OK,
                text="Não foi possível iniciar a máquina virtual"
            )
            err_dlg.format_secondary_text(msg)
            err_dlg.run()
            err_dlg.destroy()
        else:
            self.open_vm_console(self.current_selected_vm_id)
        self.update_running_ui(self.current_selected_vm_id)

    def on_open_console_clicked(self, button):
        if not self.current_selected_vm_id:
            return
        self.open_vm_console(self.current_selected_vm_id)

    def open_vm_console(self, vm_id):
        if vm_id in self.console_windows:
            win = self.console_windows[vm_id]
            win.present()
        else:
            win = VMConsoleWindow(self.manager, vm_id, parent=self)
            self.console_windows[vm_id] = win
            win.show_all()
            win.present()

    def on_stop_vm_clicked(self, button):
        if not self.current_selected_vm_id:
            return
        self.manager.stop_vm(self.current_selected_vm_id)
        self.update_running_ui(self.current_selected_vm_id)

    def on_delete_vm_clicked(self, button):
        if not self.current_selected_vm_id:
            return
        vm = self.manager.get_vm(self.current_selected_vm_id)
        if not vm:
            return

        dlg = Gtk.MessageDialog(
            transient_for=self,
            flags=Gtk.DialogFlags.MODAL,
            type=Gtk.MessageType.QUESTION,
            buttons=Gtk.ButtonsType.NONE,
            text=f"Excluir Máquina Virtual '{vm.get('name')}'?"
        )
        dlg.format_secondary_text("Esta ação removerá a máquina virtual da sua lista. Deseja também deletar o disco virtual para liberar espaço?")
        dlg.add_button("Cancelar", Gtk.ResponseType.CANCEL)
        dlg.add_button("Manter Disco", Gtk.ResponseType.NO)
        del_btn = dlg.add_button("Excluir Tudo", Gtk.ResponseType.YES)
        del_btn.get_style_context().add_class("btn-danger")

        res = dlg.run()
        if res in (Gtk.ResponseType.YES, Gtk.ResponseType.NO):
            delete_disk = (res == Gtk.ResponseType.YES)
            if self.current_selected_vm_id in self.console_windows:
                try:
                    self.console_windows[self.current_selected_vm_id].destroy()
                except Exception:
                    pass
                del self.console_windows[self.current_selected_vm_id]
            self.manager.remove_vm(self.current_selected_vm_id, delete_disk=delete_disk)
            self.current_selected_vm_id = None
            self.refresh_vm_list()

        dlg.destroy()

    def on_about_clicked(self, button):
        about = Gtk.AboutDialog(transient_for=self, modal=True)
        about.set_program_name(APP_NAME)
        about.set_version(APP_VERSION)
        about.set_comments("Gerenciador Oficial de Máquinas Virtuais do Geminux OS.\nExecute Windows, Linux e macOS com suporte e perfis para KVM / Hyper-V (.qcow2), VirtualBox (.vdi) e VMware (.vmdk).")
        about.set_website("https://github.com/miguel7435987984/geminux")
        about.set_website_label("Repositório Oficial no GitHub")
        about.set_authors(["Equipe Geminux OS", "miguel"])
        about.set_logo_icon_name("geminux-virtual-machine")
        about.run()
        about.destroy()


