    def on_bios_changed(self, button, bios_type):
        if button.get_active():
            self.selected_bios = bios_type

    def on_os_changed(self, button, os_type):
        if button.get_active():
            self.selected_os = os_type
            rec_ram = self.safe_ram.get(os_type, 1024)
            if os_type == "windows":
                self.ram_scale.set_value(rec_ram)
                self.disk_scale.set_value(64)
                self.cpu_spin.set_value(2)
                self.btn_seabios.set_active(True)
                if not self.name_entry.get_text():
                    self.name_entry.set_text("Windows 11")
            elif os_type == "macos":
                self.ram_scale.set_value(rec_ram)
                self.disk_scale.set_value(64)
                self.cpu_spin.set_value(2 if self.safe_ram["total"] <= 4096 else 4)
                self.btn_uefi.set_active(True)
                if not self.name_entry.get_text():
                    self.name_entry.set_text("macOS")
            else: # linux
                self.ram_scale.set_value(rec_ram)
                self.disk_scale.set_value(30)
                self.cpu_spin.set_value(2)
                self.btn_seabios.set_active(True)
                if not self.name_entry.get_text():
                    self.name_entry.set_text("Linux")

    def on_engine_changed(self, button, engine_type):
        if button.get_active():
            self.selected_engine = engine_type
            if engine_type == "virtualbox":
                self.selected_disk_format = "vdi"
            elif engine_type == "vmware":
                self.selected_disk_format = "vmdk"
            else:
                self.selected_disk_format = "qcow2"
            self.on_disk_changed(self.disk_scale)

    def on_ram_changed(self, scale):
        val = int(scale.get_value())
        gb = val / 1024.0
        self.ram_val_lbl.set_text(f"{val} MB ({gb:.1f} GB)")

    def on_disk_changed(self, scale):
        val = int(scale.get_value())
        fmt = getattr(self, "selected_disk_format", "qcow2")
        self.disk_val_lbl.set_text(f"{val} GB (.{fmt})")

    def get_data(self):
        name = self.name_entry.get_text().strip()
        if not name:
            name = f"Nova VM ({self.selected_os.capitalize()})"
        return {
            "name": name,
            "os_type": self.selected_os,
            "engine": self.selected_engine,
            "bios_type": getattr(self, "selected_bios", "seabios"),
            "disk_format": self.selected_disk_format,
            "ram_mb": int(self.ram_scale.get_value()),
            "cpus": int(self.cpu_spin.get_value()),
            "disk_gb": int(self.disk_scale.get_value()),
            "iso_path": self.iso_chooser.get_filename() or ""
        }


