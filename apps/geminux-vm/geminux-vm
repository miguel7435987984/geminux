    def on_delete_event(self, widget, event):
        self.hide()
        return True

    def on_toggle_pause(self, button):
        is_paused = self.manager.is_paused.get(self.vm_id, False)
        if is_paused:
            if self.manager.resume_vm(self.vm_id):
                self.btn_pause_icon.set_from_icon_name("media-playback-pause-symbolic", Gtk.IconSize.BUTTON)
                self.manager.append_log(self.vm_id, "▶️ Máquina virtual retomada.")
        else:
            if self.manager.pause_vm(self.vm_id):
                self.btn_pause_icon.set_from_icon_name("media-playback-start-symbolic", Gtk.IconSize.BUTTON)
                self.manager.append_log(self.vm_id, "⏸️ Máquina virtual pausada.")

    def on_reset(self, button):
        if self.manager.reset_vm(self.vm_id):
            self.manager.append_log(self.vm_id, "🔄 Comando de reinicialização enviado para a máquina virtual.")

    def on_send_cad(self, button):
        if self.manager.send_ctrl_alt_del(self.vm_id):
            self.manager.append_log(self.vm_id, "⌨️ Atalho Ctrl+Alt+Del enviado.")

    def on_screenshot(self, button):
        save_dir = os.path.expanduser("~/Imagens/GeminuxVM")
        os.makedirs(save_dir, exist_ok=True)
        filename = f"screenshot_{self.vm_id}_{int(time.time())}.png"
        filepath = os.path.join(save_dir, filename)
        if self.manager.take_screenshot(self.vm_id, filepath):
            self.manager.append_log(self.vm_id, f"📸 Captura de tela salva em: {filepath}")
            self.on_refresh_preview(None)

    def on_refresh_preview(self, button):
        temp_file = os.path.join(CONFIG_DIR, f"preview_{self.vm_id}.png")
        if self.manager.take_screenshot(self.vm_id, temp_file):
            try:
                pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(temp_file, 480, 300, True)
                self.preview_image.set_from_pixbuf(pixbuf)
            except Exception:
                pass

    def on_save_preview(self, button):
        self.on_screenshot(button)

    def on_poweroff(self, button):
        dlg = Gtk.MessageDialog(
            transient_for=self,
            flags=Gtk.DialogFlags.MODAL,
            type=Gtk.MessageType.QUESTION,
            buttons=Gtk.ButtonsType.NONE,
            text=f"Desligar '{self.vm.get('name')}'?"
        )
        dlg.format_secondary_text("Deseja desligar a máquina virtual de forma segura?")
        dlg.add_button("Cancelar", Gtk.ResponseType.CANCEL)
        dlg.add_button("Desligamento ACPI", Gtk.ResponseType.OK)
        dlg.add_button("Forçar Encerramento", Gtk.ResponseType.REJECT)

        resp = dlg.run()
        dlg.destroy()

        if resp == Gtk.ResponseType.OK:
            self.manager.stop_vm(self.vm_id, force=False)
        elif resp == Gtk.ResponseType.REJECT:
            self.manager.stop_vm(self.vm_id, force=True)

    def on_focus_display(self, button):
        vm_name = self.vm.get("name", "Máquina Virtual")
        target_title = f"{vm_name} - Geminux Virtual Machine"
        try:
            subprocess.run(["wmctrl", "-a", target_title], capture_output=True)
        except Exception:
            pass

    def update_logs(self):
        logs = self.manager.get_logs(self.vm_id)
        if len(logs) > self.last_log_idx:
            new_lines = "\n".join(logs[self.last_log_idx:]) + "\n"
            end_iter = self.text_buffer.get_end_iter()
            self.text_buffer.insert(end_iter, new_lines)
            self.last_log_idx = len(logs)
            end_iter = self.text_buffer.get_end_iter()
            self.text_view.scroll_to_iter(end_iter, 0.0, False, 0.0, 1.0)

    def on_timer_tick(self):
        is_run = self.manager.is_running(self.vm_id)
        is_paused = self.manager.is_paused.get(self.vm_id, False)

        sc = self.badge_lbl.get_style_context()
        if is_run:
            if is_paused:
                self.badge_lbl.set_text("🟡 Pausada")
                sc.remove_class("badge-running")
                sc.remove_class("badge-stopped")
            else:
                self.badge_lbl.set_text("🟢 Em Execução")
                sc.remove_class("badge-stopped")
                sc.add_class("badge-running")
                self.elapsed_seconds += 1

            hours = self.elapsed_seconds // 3600
            mins = (self.elapsed_seconds % 3600) // 60
            secs = self.elapsed_seconds % 60
            self.timer_lbl.set_text(f"⏱️ {hours:02d}:{mins:02d}:{secs:02d}")
            self.btn_pause.set_sensitive(True)
            self.btn_reset.set_sensitive(True)
            self.btn_cad.set_sensitive(True)
            self.btn_snap.set_sensitive(True)
            self.btn_power.set_sensitive(True)
        else:
            self.badge_lbl.set_text("⚪ Desligada")
            sc.remove_class("badge-running")
            sc.add_class("badge-stopped")
            self.btn_pause.set_sensitive(False)
            self.btn_reset.set_sensitive(False)
            self.btn_cad.set_sensitive(False)
            self.btn_snap.set_sensitive(False)
            self.btn_power.set_sensitive(False)

        self.update_logs()
        return True


